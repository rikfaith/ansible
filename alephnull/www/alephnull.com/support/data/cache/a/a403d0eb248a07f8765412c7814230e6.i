a:103:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:0;}i:2;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:32:"Baked Potato Soup, By Ali Slagle";}i:2;i:1;}i:3;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:33;}i:4;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:33;}i:5;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:561:"If we’re being honest, a baked potato isn’t really about the potato. It’s about the toppings: plush sour cream, butter, cheese, salty bacon, bright scallions. This soup version doesn’t skimp on those extras: The potatoes simmer in milk with garlic and scallions until just tender, then they join sour cream and Cheddar in the pot before the toppings — including potato skins — are added. It’s potatoey, creamy and adaptable. Make it smooth or textured, skip the bacon and-or serve it with a side salad (though it’s plenty hearty all on its own).";}i:2;i:35;}i:6;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:596;}i:7;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:596;}i:8;a:3:{i:0;s:11:"strong_open";i:1;a:0:{}i:2;i:599;}i:9;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:11:"INGREDIENTS";}i:2;i:601;}i:10;a:3:{i:0;s:12:"strong_close";i:1;a:0:{}i:2;i:612;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:614;}i:12;a:3:{i:0;s:10:"listu_open";i:1;a:0:{}i:2;i:614;}i:13;a:3:{i:0;s:13:"listitem_open";i:1;a:1:{i:0;i:1;}i:2;i:614;}i:14;a:3:{i:0;s:16:"listcontent_open";i:1;a:0:{}i:2;i:614;}i:15;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:49:" 6 slices bacon, or 3 tablespoons unsalted butter";}i:2;i:618;}i:16;a:3:{i:0;s:17:"listcontent_close";i:1;a:0:{}i:2;i:667;}i:17;a:3:{i:0;s:14:"listitem_close";i:1;a:0:{}i:2;i:667;}i:18;a:3:{i:0;s:13:"listitem_open";i:1;a:1:{i:0;i:1;}i:2;i:667;}i:19;a:3:{i:0;s:16:"listcontent_open";i:1;a:0:{}i:2;i:667;}i:20;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:66:" 1 bunch scallions, white and green parts thinly sliced separately";}i:2;i:671;}i:21;a:3:{i:0;s:17:"listcontent_close";i:1;a:0:{}i:2;i:737;}i:22;a:3:{i:0;s:14:"listitem_close";i:1;a:0:{}i:2;i:737;}i:23;a:3:{i:0;s:13:"lis