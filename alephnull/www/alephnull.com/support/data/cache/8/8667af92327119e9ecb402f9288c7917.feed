    <item rdf:about="https://hybridsky.org/w/recipes/best_low-carb_coleslaw?rev=1605745239&amp;do=diff">
        <dc:format>text/html</dc:format>
        <dc:date>2020-11-18T19:20:39-0400</dc:date>
