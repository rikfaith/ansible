1.Cover 1 dozen eggs with water and bring to a boil. Turn to low and let sit for 15 minutes. Turn off heat, let sit for 10 minutes, then drain water.
2. Peel eggs, cut in half lengthwise and remove all yolks.
3. Add yolks to bowl along with 1/4 cup mayonnaise.";}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1510264383;s:8:"modified";i:1605823750;}s:7:"creator";s:21:"Melissa Clepper-Faith";s:4:"user";s:3:"mcf";s:11:"last_change";a:7:{s:4:"date";i:1605823750;s:2:"ip";s:13:"71.210.63.248";s:4:"type";s:1:"E";s:2:"id";s:20:"recipes:deviled_eggs";s:4:"user";s:3:"mcf";s:3:"sum";s:0:"";s:5:"extra";s:0:"";}s:11:"contributor";a:1:{s:3:"mcf";s:21:"Melissa Clepper-Faith";}}}