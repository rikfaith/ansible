(From Aleksa, August 2023)

	*  150g (5.2oz) of butter
	*  150g (5.2oz) of sugar 
	*  1 egg
	*  4 spoons of milk
	*  4 spoons of honey
	*  1 teaspoon baking soda
	*  cinnamon, per taste
	*  flour, if needed

Mix all ingredients and form a batter. Make shapes with cookie cutters. Bake at 350F until done.";}s:8:"relation";a:2:{s:5:"media";a:1:{s:46:"recipes:signal-2023-08-11-17-13-18-927_720.jpg";b:1;}s:10:"firstimage";s:46:"recipes:signal-2023-08-11-17-13-18-927_720.jpg";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1691765250;s:8:"modified";i:1691770776;}s:7:"creator";s:9:"Rik Faith";s:4:"user";s:5:"faith";s:11:"last_change";a:8:{s:4:"date";i:1691770776;s:2:"ip";s:12:"24.163.79.73";s:4:"type";s:1:"E";s:2:"id";s:18:"recipes:honeycakes";s:4:"user";s:5:"faith";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-1;}s:11:"contributor";a:1:{s:5:"faith";s:9:"Rik Faith";}}}