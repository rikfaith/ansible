* Setup of new RAID-1

	*  badblocks -b 4096 -s -v -w -p 1 -t random
	*  fdisk -H 224 -S 56
	*  mdadm -C /dev/md_d1 /dev/sd[cd]1 -c 128 -n 2 -l 1
	*  cryptsetup -c aes-cbc-essiv:sha256 -s 128 -h sha256 --align-payload=256 luksFormat /dev/md_d1
	*  cryptsetup luksOpen /dev/md_d1 r1
	*  pvcreate --metadatasize 506k /dev/mapper/r1
	*  pvs /dev/mapper/r1 -o+pe_start
	*  vgcreate -s 1g v1 /dev/mapper/r1
	*  lvcreate -L 500g -n home v1
	*  mke2fs -t ext4 -m0 -E stride=32,stripe-width=128…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:18:"private:m2n-vm.jpg";}}s:10:"persistent";a:4:{s:4:"date";a:2:{s:7:"created";i:1220815347;s:8:"modified";i:1295955743;}s:7:"creator";s:9:"Rik Faith";s:11:"last_change";a:7:{s:4:"date";i:1295955743;s:2:"ip";s:13:"67.238.234.49";s:4:"type";s:1:"E";s:2:"id";s:12:"private:home";s:4:"user";s:5:"faith";s:3:"sum";s:0:"";s:5:"extra";s:0:"";}s:11:"contributor";a:1:{s:5:"faith";s:9:"Rik Faith";}}}