myhostname = pan.alephnull.com
myorigin = $myhostname

mydestination = $myhostname alephnull.com localhost.localdomain localhost

mynetworks = 127.0.0.0/8
inet_interfaces = 216.18.20.172 localhost

virtual_alias_domains = 
  bogus.org
  tarball.org
  urmp.org

virtual_alias_maps =
  hash:/etc/postfix/virtual/faith
  hash:/etc/postfix/virtual/kem
  hash:/etc/postfix/virtual/tell

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
relayhost = 
mailbox_size_limit = 0
recipient_delimiter = +

# Stuff from the Ubuntu default main.cf
smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no
append_dot_mydomain = no
readme_directory = no

# TLS
smtpd_use_tls=yes
smtpd_tls_cert_file=/etc/postfix/certs/pan.alephnull.com.crt
smtpd_tls_key_file=/etc/postfix/certs/pan.alephnull.com.key
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtpd_tls_session_cache_timeout = 3600s
tls_random_source = dev:/dev/urandom
smtpd_tls_auth_only = yes

# SASL
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous, noplaintext
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth

# Turn on for debugging to /var/log/mail.log
# Be aware that AUTH PLAIN is reversible!
#debug_peer_list = 71.50.159.244

# Turn on for testing
soft_bounce = yes

# Anti-spam from http://www.freesoftwaremagazine.com/articles/focus_spam_postfix/
# and from crab
smtpd_helo_required = yes
smtpd_helo_restrictions =
  permit_mynetworks
  reject_non_fqdn_hostname
  reject_invalid_hostname
smtpd_client_restrictions =
  permit_mynetworks
  permit_sasl_authenticated
  check_sender_access hash:/etc/postfix/clients
smtpd_sender_restrictions =
  permit_mynetworks
  permit_sasl_authenticated
  check_sender_access hash:/etc/postfix/senders
  reject_non_fqdn_sender
smtpd_recipient_restrictions =
  permit_mynetworks
  permit_sasl_authenticated
  check_recipient_access hash:/etc/postfix/recipients
  reject_unauth_destination
  reject_non_fqdn_recipient
  reject_unknown_recipient_domain
  reject_unauth_pipelining
  reject_rbl_client zen.spamhaus.org
  reject_rbl_client bl.spamcop.net
  reject_rbl_client cbl.abuseat.org
smtpd_data_restrictions =
  reject_unauth_pipelining

