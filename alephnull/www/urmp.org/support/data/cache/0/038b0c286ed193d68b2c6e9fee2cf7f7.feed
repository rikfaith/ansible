    <item rdf:about="http://urmp.org/notes/start?rev=1248477725&amp;do=diff">
        <dc:format>text/html</dc:format>
        <dc:date>2009-07-24T19:22:05-05:00</dc:date>
        <dc:creator>faith</dc:creator>
        <title>notes:start</title>
        <link>http://urmp.org/notes/start?rev=1248477725&amp;do=diff</link>
        <description>*  MD5 and SHA-1 verification: &lt;http://www.nsrl.nist.gov/testdata/&gt;
	*  Open source SHA-2 implementation: &lt;http://www.ouah.org/ogay/sha2/&gt;
	*  djb's public domain SHA-1: &lt;http://cr.yp.to/nearsha.html&gt;</description>
    </item>
