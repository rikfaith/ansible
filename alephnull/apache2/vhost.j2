{# alephnull per-site Apache vhost.
   vars: name, docroot, wiki (bool), php (bool), pool (fpm pool name),
         cert (letsencrypt live dir), aliases (list, extra names such as
         test.<name> for testing the VM before cutover),
         redirect_to ("" for normal sites) #}
{% if redirect_to %}
<VirtualHost {{ name }}:443>
  ServerName {{ name }}
  ServerAdmin faith@alephnull.com
  RedirectPermanent / {{ redirect_to }}

  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/{{ cert }}/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/{{ cert }}/privkey.pem
  Include /etc/letsencrypt/options-ssl-apache.conf

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</VirtualHost>

<VirtualHost www.{{ name }}:443>
  ServerName www.{{ name }}
  RedirectPermanent / {{ redirect_to }}

  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/{{ cert }}/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/{{ cert }}/privkey.pem
  Include /etc/letsencrypt/options-ssl-apache.conf

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</VirtualHost>

<VirtualHost {{ name }}:80>
  ServerName {{ name }}
  RedirectPermanent / {{ redirect_to }}
</VirtualHost>

<VirtualHost www.{{ name }}:80>
  ServerName www.{{ name }}
  RedirectPermanent / {{ redirect_to }}
</VirtualHost>
{% else %}
<VirtualHost {{ name }}:443>
  ServerName {{ name }}
{% if aliases is defined and aliases %}
  ServerAlias {{ aliases | join(' ') }}
{% endif %}
  ServerAdmin faith@alephnull.com
  DocumentRoot {{ docroot }}

  TransferLog "|/usr/bin/cronolog /var/log/httpd/{{ name }}/%Y/%m/access.%Y%m%d.log"
  ErrorLog "|/usr/bin/cronolog /var/log/httpd/{{ name }}/%Y/%m/error.%Y%m%d.log"

  <Directory {{ docroot }}>
    Options FollowSymLinks
    AllowOverride None
    Require all granted
  </Directory>
{% if wiki %}
  Alias /wiki {{ support }}/
  <Directory {{ support }}>
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
  </Directory>
  <Directory {{ support }}/conf>
    Require all denied
  </Directory>
  <FilesMatch "\.db$">
    Require all denied
  </FilesMatch>
{% endif %}
{% if php %}
  <FilesMatch "\.php$">
    SetHandler "proxy:unix:/run/php/php-fpm-{{ pool }}.sock|fcgi:///"
  </FilesMatch>
{% endif %}
  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/{{ cert }}/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/{{ cert }}/privkey.pem
  Include /etc/letsencrypt/options-ssl-apache.conf

  LimitRequestBody 65536
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</VirtualHost>

<VirtualHost www.{{ name }}:443>
  ServerName www.{{ name }}
  RedirectPermanent / https://{{ name }}/

  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/{{ cert }}/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/{{ cert }}/privkey.pem
  Include /etc/letsencrypt/options-ssl-apache.conf

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</VirtualHost>

<VirtualHost {{ name }}:80>
  ServerName {{ name }}
{% if aliases is defined and aliases %}
  ServerAlias {{ aliases | join(' ') }}
{% endif %}
  RewriteEngine on
  RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
</VirtualHost>

<VirtualHost www.{{ name }}:80>
  ServerName www.{{ name }}
  RedirectPermanent / https://{{ name }}/
</VirtualHost>
{% endif %}
