{# per-site php-fpm pool (one per PHP-serving site).
   vars: name (also the socket suffix) #}
[{{ name }}]
user = www-data
group = www-data
listen = /run/php/php-fpm-{{ name }}.sock
listen.owner = www-data
listen.group = www-data
pm = dynamic
pm.max_children = 4
pm.start_servers = 1
pm.min_spare_servers = 1
pm.max_spare_servers = 2
php_value[include_path] = ".:/www/{{ name }}/support"
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/php-fpm/{{ name }}.log
