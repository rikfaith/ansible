#!/usr/bin/python3
#
# Name   : Dict
# Purpose: dict.org CGI program to submit dict queries.
#
# Secure Python rewrite of the original Perl CGI (1997-2011,
# D. L. Hoffman / R. Faith). The URL interface is unchanged, but the
# shell-injection and HTML-injection holes of the original are closed:
#
#   * No shell is ever invoked. The dict client runs with an explicit
#     argument vector, so user input is never parsed by a shell.
#   * Database and strategy values are validated against the dict
#     server's own -DS list before use.
#   * All dynamic output is HTML-escaped; generated URLs are
#     percent-encoded.
#   * POST bodies are size-limited; dict invocations are
#     time-limited.
#   * Security headers: Content-Security-Policy (nonce-based),
#     X-Content-Type-Options, X-Frame-Options, Referrer-Policy.
#
# Configuration overrides (environment):
#   DICT_BIN      path to the dict client (default /usr/bin/dict)
#   DICT_SERVERS  comma-separated dictd hosts (default localhost)
#   DICT_TIMEOUT  per-invocation timeout in seconds (default 10)
#   DICT_DEBUG    if set, log each dict invocation to stderr
#

import base64
import html
import ipaddress
import os
import re
import secrets
import subprocess
import sys
import urllib.parse

PGM = "Dict"

DICT_BIN = os.environ.get("DICT_BIN", "/usr/bin/dict")
SERVERS = [s for s in os.environ.get("DICT_SERVERS", "localhost").split(",")
           if s]
try:
    DICT_TIMEOUT = float(os.environ.get("DICT_TIMEOUT", "10"))
except ValueError:
    DICT_TIMEOUT = 10.0
DEBUG = bool(os.environ.get("DICT_DEBUG"))

MAX_POST_BYTES = 64 * 1024   # POST body limit
MAX_QUERY_LEN = 200          # query length limit
MAX_CLIENT_LEN = 255         # client string length limit

RETURN_URL = "/bin/Dict"
COPYRIGHT_INFO_URL = (RETURN_URL +
                      "?Form=Dict1&Query=00-database-info"
                      "&Strategy=*&Database=*")
SERVER_INFO_URL = RETURN_URL + "?Form=Dict4"

BUILTIN_DATABASES = {"*": "Any", "!": "First match"}
BUILTIN_STRATEGIES = {"*": "Return Definitions"}

BACKEND_DOWN = "Backend database engine error: please try again later"

CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
WS_RE = re.compile(r"\s+")
FROM_RE = re.compile(r"^From\s*(.*)\s*\[(.*)\]\s*:(.*)$")
COUNT_RE = re.compile(r"^\d+ ")
WORDLIST_HEAD_RE = re.compile(r"^(\S+) ")
WORDLIST_MORE_RE = re.compile(r"^  (\S+) ")
URL_RE = re.compile(r"(ftp|http)://[^\s\)\}]*")
BRACE_RE = re.compile(r"(\s)\{([^}\s][^}]*)\}")
BRACE_OPEN_RE = re.compile(r"(\s)\{([^}\s][^}]*)$")


def esc(text):
    return html.escape(text, quote=True)


def q(text):
    return urllib.parse.quote_plus(text)


def log(message):
    if DEBUG:
        sys.stderr.write("Dict: %s\n" % message)


class HttpError(Exception):
    def __init__(self, status, reason):
        super().__init__(reason)
        self.status = status
        self.reason = reason


def drain_stdin(limit):
    """Discard up to `limit` bytes of the request body so the client
    connection can be closed cleanly after an error response."""
    remaining = limit
    while remaining > 0:
        chunk = sys.stdin.buffer.read(min(65536, remaining))
        if not chunk:
            break
        remaining -= len(chunk)


DRAIN_CAP = MAX_POST_BYTES + 1024 * 1024


def declared_length():
    """Return the declared request body length, or None if malformed."""
    raw = os.environ.get("CONTENT_LENGTH", "")
    if not raw:
        return 0
    try:
        length = int(raw)
    except ValueError:
        return None
    return length if length >= 0 else None


def read_request():
    """Read the CGI request. Return a dict of first-seen parameters.

    On early errors the (possibly unread) request body is drained so
    the client connection can be closed cleanly."""
    method = os.environ.get("REQUEST_METHOD", "")
    length = declared_length()
    if method == "GET":
        body = os.environ.get("QUERY_STRING", "")
    elif method == "POST":
        if length is None:
            drain_stdin(DRAIN_CAP)
            raise HttpError(400, "Malformed Content-Length header")
        if length > MAX_POST_BYTES:
            # Cap the drain: a client may claim more than it sends.
            drain_stdin(min(length, DRAIN_CAP))
            raise HttpError(413, "Request entity too large")
        data = sys.stdin.buffer.read(length)
        body = data.decode("utf-8", "replace")
    else:
        if length:
            drain_stdin(min(length, DRAIN_CAP))
        raise HttpError(405, "Only GET and POST are allowed")
    params = urllib.parse.parse_qs(body, keep_blank_values=True)
    return {key: values[0] for key, values in params.items()}


def clean_query(value):
    """Normalize a query value: drop control characters, apply the
    legacy compatibility mappings, collapse whitespace, cap length."""
    value = CONTROL_RE.sub(" ", value)
    value = value.replace("{", "(").replace("}", ")")
    value = value.replace(";", " ").replace("'", "")
    value = WS_RE.sub(" ", value).strip()
    return value[:MAX_QUERY_LEN]


def client_string():
    """Build the --client logging string from REMOTE_ADDR and the
    User-Agent. Both are validated/sanitized; neither can carry shell
    syntax because it is passed as a single argv element."""
    parts = []
    addr = os.environ.get("REMOTE_ADDR", "")
    if addr:
        try:
            ipaddress.ip_address(addr)
        except ValueError:
            addr = ""
    if addr:
        parts.append(addr)
    ua = os.environ.get("HTTP_USER_AGENT", "")
    if ua:
        ua = "".join(ch for ch in ua if 0x20 <= ord(ch) <= 0x7e)
        parts.append(ua[:MAX_CLIENT_LEN])
    return " ".join(parts)


def run_dict(server, args):
    """Run the dict client against a server.

    Return (text, ok). ok is False if the client could not be run,
    timed out, or produced no output at all."""
    argv = [DICT_BIN, "-h", server] + args
    log("argv: " + " ".join(repr(a) for a in argv))
    try:
        proc = subprocess.run(
            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=DICT_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return "", False
    out = proc.stdout.decode("utf-8", "replace")
    err = proc.stderr.decode("utf-8", "replace")
    if err.strip():
        text = (out + "\n" if out.strip() else "") + err
    else:
        text = out
    return text, bool(text.strip())


def enumerate_server(server):
    """Return (databases, strategies) name->description dicts from the
    server's -DS response, or (None, None) on failure."""
    text, ok = run_dict(server, ["-DS"])
    if not ok:
        return None, None
    databases = dict(BUILTIN_DATABASES)
    strategies = dict(BUILTIN_STRATEGIES)
    section = None
    for line in text.splitlines():
        if line.startswith("Strategies"):
            section = strategies
        elif line.startswith("Databases") or line.startswith("Database"):
            section = databases
        elif section is not None and line.strip():
            parts = line.split(None, 1)
            section[parts[0]] = parts[1] if len(parts) > 1 else parts[0]
    return databases, strategies


def build_query_args(form, database, strategy, query):
    """Build the dict client argument vector for a query.

    Strategy "*" is the plain define form; other strategies use the
    match form (word lists)."""
    if form == "Dict3":
        return ["-i", database]
    if form == "Dict4":
        return ["-I"]
    if strategy == "*":
        return ["-d", database, query]
    return ["-d", database, "-s", strategy, "-m", query]


def run_query(args):
    """Run the query against each server in order.

    Return (text, used_backup) or (None, False)."""
    client = client_string()
    prefix = ["--client", client] if client else []
    for i, server in enumerate(SERVERS):
        text, ok = run_dict(server, prefix + args)
        if ok:
            return text, i > 0
    return None, False


#
# ---------- Result rendering
#
# The dict client's output is rendered into HTML, preserving the
# historical look: <pre> blocks, bold "From" and count lines, search
# links for definition cross-references ({word}), quoted phrases and
# bare URLs. Everything is escaped before any tag is inserted.

def urls_in(text):
    """Escape text, turning bare URLs into anchors."""
    out = []
    pos = 0
    for m in URL_RE.finditer(text):
        out.append(esc(text[pos:m.start()]))
        url = m.group(0)
        out.append('<a href="%s">%s</a>' % (esc(url), esc(url)))
        pos = m.end()
    out.append(esc(text[pos:]))
    return "".join(out)


def scan_inline(line):
    """Escape a line of text, anchoring bare URLs and single-line
    {word} cross-references."""
    out = []
    pos = 0
    while pos < len(line):
        url_m = URL_RE.search(line, pos)
        br_m = BRACE_RE.search(line, pos)
        if url_m is None and br_m is None:
            out.append(esc(line[pos:]))
            break
        if br_m is not None and (url_m is None or br_m.start() < url_m.start()):
            m = br_m
        else:
            m = url_m
        out.append(esc(line[pos:m.start()]))
        if m is url_m:
            url = m.group(0)
            out.append('<a href="%s">%s</a>' % (esc(url), esc(url)))
        else:
            word = m.group(2)
            out.append(m.group(1))
            out.append('<a href="%s?Form=Dict2&Database=*&Query=%s">%s</a>'
                       % (esc(RETURN_URL), q(word), esc(word)))
        pos = m.end()
    return "".join(out)


def scan_text(line):
    """Process a definition line. Return (html, pending), where
    pending is the first part of an unclosed {word} cross-reference
    at end of line, or None."""
    open_m = BRACE_OPEN_RE.search(line)
    if open_m:
        head = line[:open_m.start(1)]
        word = open_m.group(2)
        return (scan_inline(head) + open_m.group(1) +
                '<a href="%s?Form=Dict2&Database=*&Query=%s">%s\n</a>'
                % (esc(RETURN_URL), q(word), esc(word))), word
    return scan_inline(line), None


def text_line(line, pending):
    """Render a plain definition line, tracking {word} cross-references
    that span line breaks. Return (html, pending_after)."""
    if pending is not None:
        idx = line.find("}")
        if idx >= 0:
            stripped = line.lstrip()
            lead_ws = line[:len(line) - len(stripped)]
            core = line[len(lead_ws):idx]
            rest = line[idx + 1:]
            word = (pending + " " + core.strip()).strip()
            frag = (lead_ws +
                    '<a href="%s?Form=Dict2&Database=*&Query=%s">%s</a>'
                    % (esc(RETURN_URL), q(word), esc(core)))
            html_rest, new_pending = scan_text(rest)
            if new_pending is not None:
                # The line's newline lives inside the opening anchor.
                return frag + html_rest, new_pending
            return frag + html_rest + "\n", new_pending
        return scan_inline(line) + "\n", pending
    html, pending = scan_text(line)
    if pending is not None:
        # The line's newline lives inside the opening anchor.
        return html, pending
    return html + "\n", pending


def anchor_line(dbname, text):
    """Link-ify a word-list line: every whitespace-delimited token
    outside double quotes becomes a search link; quoted phrases become
    phrase-search links (with literal single quotes, as before)."""
    db = q(dbname)
    parts = []
    odd = True
    for seg in text.split('"'):
        if odd:
            def repl(m):
                tok = m.group(1)
                return (' <a href="%s?Form=Dict2&Database=%s&Query=%s">%s</a>'
                        % (esc(RETURN_URL), db, q(tok), esc(tok)))
            parts.append(re.sub(r" (\S+)", repl, seg))
        else:
            phrase = seg
            parts.append('<a href="%s?Form=Dict2&Database=%s&Query=\'%s\'">'
                         '"%s"</a>'
                         % (esc(RETURN_URL), db, q(phrase), esc(phrase)))
        odd = not odd
    return "".join(parts)


def render_line(line, state, db, query):
    """Render one line of dict client output. Return (html, state)."""
    m = FROM_RE.match(line)
    if m:
        name, desc = m.group(2), m.group(1)
        return ("</pre><b>From <a href=\"%s?Form=Dict3&Database=%s\">%s"
                "</a>:\n</b><pre>\n" % (esc(RETURN_URL), q(name), esc(desc))), state
    if line.startswith("From"):
        return "</pre><b>%s\n</b><pre>\n" % esc(line), state
    if COUNT_RE.match(line):
        return ("</pre><b>%s\n for <a href=\"%s?Form=Dict2&Database=%s"
                "&Query=%s\">%s</a></b><pre>"
                % (esc(line), esc(RETURN_URL), q(db), q(query), esc(query))), state
    if line.startswith("No definitions") or line.startswith("No matches"):
        return "</pre><b>%s\n</b><pre>\n" % esc(line), state
    m = WORDLIST_HEAD_RE.match(line)
    if m:
        if ":" in line:
            dbn, rest = line.split(":", 1)
            frag = "<b>%s:</b>%s\n" % (esc(dbn), anchor_line(dbn, rest))
        else:
            dbn, frag = m.group(1), "<b>%s:</b>\n" % esc(line)
        state = dict(state)
        state["wordlist"] = dbn
        return frag, state
    if state["wordlist"] is not None and WORDLIST_MORE_RE.match(line):
        return anchor_line(state["wordlist"], line) + "\n", state
    html, pending = text_line(line, state["pending"])
    state = dict(state)
    state["pending"] = pending
    return html, state


def render_result(text, db, query, used_backup):
    """Render the full dict client output."""
    parts = ["<pre>"]
    if used_backup:
        parts.append("</pre><b>Using backup server...</b>\n<hr><p><pre>\n")
    state = {"wordlist": None, "pending": None}
    for line in text.splitlines():
        frag, state = render_line(line, state, db, query)
        parts.append(frag)
    parts.append("</pre>\n<hr>\n")
    return "".join(parts)


#
# ---------- Page assembly
#

def render_form(query, strategy, database, strategy_opts, database_opts):
    s_opts = "".join(
        "        <option value=\"%s\"%s>%s\n"
        % (esc(name), " selected" if name == strategy else "", esc(desc))
        for name, desc in strategy_opts)
    d_opts = "".join(
        "        <option value=\"%s\"%s>%s\n"
        % (esc(name), " selected" if name == database else "", esc(desc))
        for name, desc in database_opts)
    return (
        "<form name=\"DICT\" method=\"POST\" action=\"%s\">\n"
        "    <input type=\"hidden\" name=\"Form\" value=\"Dict1\">\n"
        "    <center>\n"
        "\t<table><tr><td align=\"right\">\n"
        "\t<b>Search for:</b></td><td>\n"
        "\t<input type=\"text\" name=\"Query\" size=40 value=\"%s\">\n"
        "        <br></td></tr><td align=\"right\">\n"
        "        <b>Search type:</b></td><td align=\"left\">\n"
        "        <select name=\"Strategy\">\n"
        "%s        </select>\n"
        "\t<br></td></tr><td align=\"right\">\n"
        "        <b>Database:</b></td><td>\n"
        "        <select name=\"Database\">\n"
        "%s        </select>\n"
        "\t</td></tr></table>\n"
        "        <input type=\"submit\" name=\"submit\" value=\"Submit query\">\n"
        "        <input type=\"reset\" value=\"Reset form\">\n"
        "\t<p>\n"
        "\t<a href=\"%s\">Database copyright information</a>\n"
        "\t<br>\n"
        "\t<a href=\"%s\">Server information</a>\n"
        "    </center>\n"
        "</form>\n"
        "<hr>\n"
        % (esc(RETURN_URL), esc(query), s_opts, d_opts,
           esc(COPYRIGHT_INFO_URL), esc(SERVER_INFO_URL)))


def option_list(builtins, server_map):
    items = list(builtins.items())
    seen = set(builtins)
    for name, desc in server_map.items():
        if name not in seen:
            seen.add(name)
            items.append((name, desc))
    return items


def page_html(nonce, title, error_html, form_html, result_html):
    return (
        "<!DOCTYPE html>\n"
        "<html>\n"
        "<head>\n"
        "<meta charset=\"utf-8\">\n"
        "<title>%s</title>\n"
        "<link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\">\n"
        "</head>\n"
        "<body bgcolor=\"#ffffff\" text=\"#000000\">\n"
        "<center>\n"
        "<a href=\"https://www.dict.org/\"><img src=\"/gifs/dict.org-300x83.gif\"\n"
        "width=\"300\" height=\"83\" alt=\"dict.org\"></a>\n"
        "<br>\n"
        "<H1>The DICT Development Group</H1>\n"
        "</center>\n"
        "<br>\n"
        "%s"
        "%s"
        "<script nonce=\"%s\">document.DICT.Query.focus()</script>\n"
        "%s"
        "    <center>\n"
        "    <font size=\"-1\">\n"
        "\tContact=<a href=\"mailto:webmaster@dict.org\">webmaster@dict.org</a>"
        " Specification=<a href=\"https://tools.ietf.org/html/rfc2229\">RFC 2229</a>\n"
        "\t<br>\n"
        "    </font>\n"
        "</center>\n"
        "</body>\n"
        "</html>\n"
        % (esc(title), error_html, form_html, nonce, result_html))


REASON_PHRASES = {
    400: "Bad Request",
    405: "Method Not Allowed",
    413: "Request Entity Too Large",
    500: "Internal Server Error",
}


def send(status, nonce, body, allow=False):
    out = []
    if status != 200:
        out.append("Status: %d %s"
                   % (status, REASON_PHRASES.get(status, "Error")))
    out.append("Content-Type: text/html; charset=utf-8")
    out.append(
        "Content-Security-Policy: "
        "default-src 'self'; img-src 'self' data:; style-src 'self'; "
        "script-src 'nonce-%s'; base-uri 'self'; form-action 'self'; "
        "frame-ancestors 'self'" % nonce)
    out.append("X-Content-Type-Options: nosniff")
    out.append("X-Frame-Options: SAMEORIGIN")
    out.append("Referrer-Policy: strict-origin-when-cross-origin")
    if allow:
        out.append("Allow: GET, POST")
    out.append("Cache-Control: no-store")
    sys.stdout.write("\r\n".join(out) + "\r\n\r\n" + body)
    sys.stdout.flush()


def main():
    nonce = base64.b64encode(secrets.token_bytes(16)).decode("ascii")
    try:
        params = read_request()
    except HttpError as exc:
        body = ("<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\">"
                "<title>dict.org</title></head><body><h1>%d %s</h1><p>%s</p>"
                "</body></html>\n"
                % (exc.status, esc(REASON_PHRASES.get(exc.status, "Error")),
                   esc(exc.reason)))
        send(exc.status, nonce, body, allow=(exc.status == 405))
        return

    form = params.get("Form", "")
    raw_query = params.get("Query", "")
    raw_db = params.get("Database", "")
    raw_st = params.get("Strategy", "")
    query = clean_query(raw_query)

    databases, strategies = None, None
    for server in SERVERS:
        databases, strategies = enumerate_server(server)
        if databases is not None:
            break

    error = None
    result = None
    used_backup = False
    show_q, show_st, show_db = "", "", "*"

    if form == "":
        show_q, show_st, show_db = "", "*", "*"
    elif form == "Dict1":
        show_q, show_st, show_db = query, raw_st, raw_db
        if not query:
            error = "Query is required."
        elif databases is None:
            error = BACKEND_DOWN
        elif raw_db not in databases:
            error = "Unknown database: %s" % esc(raw_db)
        elif raw_st not in strategies:
            error = "Unknown strategy: %s" % esc(raw_st)
        else:
            result, used_backup = run_query(
                build_query_args(form, raw_db, raw_st, query))
            if result is None:
                error = BACKEND_DOWN
    elif form == "Dict2":
        show_q, show_st, show_db = query, "*", raw_db
        if not query:
            error = "Query is required."
        elif databases is None:
            error = BACKEND_DOWN
        elif raw_db not in databases:
            error = "Unknown database: %s" % esc(raw_db)
        else:
            result, used_backup = run_query(
                build_query_args(form, raw_db, "*", query))
            if result is None:
                error = BACKEND_DOWN
    elif form == "Dict3":
        show_q, show_st, show_db = "", "", raw_db
        db = raw_db or "*"
        if db not in (databases or {}):
            error = BACKEND_DOWN if databases is None \
                else "Unknown database: %s" % esc(db)
        else:
            result, used_backup = run_query(build_query_args(form, db, "", ""))
            if result is None:
                error = BACKEND_DOWN
    elif form == "Dict4":
        show_q, show_st, show_db = "", "", raw_db
        result, used_backup = run_query(build_query_args(form, "", "", ""))
        if result is None:
            error = BACKEND_DOWN
    else:
        error = "Error, invalid syntax: %s" % esc(form)
        show_q, show_st, show_db = "", "*", "*"

    title = "dict.org"
    if query and form in ("Dict1", "Dict2"):
        title += "- " + query

    strategy_opts = option_list(BUILTIN_STRATEGIES,
                                strategies or {})
    database_opts = option_list(BUILTIN_DATABASES, databases or {})

    error_html = "<p><b>%s</b></p>\n" % error if error else ""
    result_html = ""
    if result is not None:
        result_html = render_result(result, show_db or "*", query,
                                    used_backup)

    form_html = render_form(show_q, show_st, show_db,
                            strategy_opts, database_opts)
    send(200, nonce, page_html(nonce, title, error_html, form_html,
                               result_html))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        import traceback
        traceback.print_exc(file=sys.stderr)
        sys.stderr.write("Dict: %s\n" % PGM)
